---
interface Props {
  as?: "div" | "section" | "header" | "footer" | "main";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>

<style>
  .container {
    width: min(100% - (var(--gutter) * 2), var(--container-max));
    margin-inline: auto;
  }
</style>
