<style>
  .orb {
    aspect-ratio: 1;
    isolation: isolate;
    margin-inline: auto;
    max-width: 29rem;
    position: relative;
    width: min(78vw, 29rem);
  }

  .orb__halo {
    background: radial-gradient(circle, rgb(52 120 255 / 22%) 0%, rgb(52 120 255 / 8%) 35%, transparent 70%);
    border-radius: 50%;
    inset: 5%;
    position: absolute;
    transform: scale(1.14);
    z-index: -1;
  }

  .orb__svg {
    height: 100%;
    overflow: visible;
    width: 100%;
  }

  .orb__outer,
  .orb__latitude,
  .orb__longitude,
  .orb__signal {
    transform-box: fill-box;
    transform-origin: center;
  }

  .orb__latitude {
    animation: orb-latitude 24s linear infinite;
  }

  .orb__longitude {
    animation: orb-longitude 30s linear infinite;
  }

  .orb__signal {
    animation: orb-signal 18s ease-in-out infinite alternate;
  }

  @keyframes orb-latitude {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes orb-longitude {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @keyframes orb-signal {
    from { transform: translate(-3px, 2px); opacity: 0.72; }
    to { transform: translate(4px, -3px); opacity: 1; }
  }

  @media (max-width: 47.99rem) {
    .orb {
      max-width: 16.5rem;
      width: min(68vw, 16.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb__latitude,
    .orb__longitude,
    .orb__signal {
      animation: none;
    }
  }
</style>
