---
import Container from "./Container.astro";

const problemAreas = [
  {
    number: "01",
    title: "Rentabilidad",
    description:
      "Costos, márgenes y resultados pueden analizarse de forma fragmentada, dificultando reconocer qué factores están afectando el desempeño económico."
  },
  {
    number: "02",
    title: "Operaciones",
    description:
      "Procesos ineficientes, tareas repetitivas o recursos mal aprovechados pueden consumir tiempo y capacidad sin hacerse evidentes en la operación diaria."
  },
  {
    number: "03",
    title: "Crecimiento",
    description:
      "Cuando faltan criterios y métricas suficientes, resulta más difícil evaluar qué iniciativas conviene priorizar y cuál podría ser su impacto."
  }
];
---

<section class="problem" aria-labelledby="problema-title" data-reveal-section>
  <Container>
    <div class="problem__intro">
      <div data-reveal style="--reveal-delay: 0ms">
        <p class="section-eyebrow">El problema</p>
        <h2 id="problema-title">
          Cuando la información está dispersa, decidir qué mejorar primero se vuelve más difícil.
        </h2>
      </div>
      <p class="problem__lead" data-reveal style="--reveal-delay: 90ms">
        Algunos negocios pueden tener señales relevantes en sus costos, procesos o decisiones comerciales
        sin una visión conjunta que permita interpretarlas y priorizarlas.
      </p>
    </div>

    <div class="problem__areas" aria-label="Áreas que el diagnóstico busca comprender">
      {
        problemAreas.map((area, index) => (
          <article class="problem__area" data-reveal style={`--reveal-delay: ${160 + index * 80}ms`}>
            <p class="problem__number" aria-hidden="true">{area.number}</p>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))
      }
    </div>

    <p class="problem__bridge" data-reveal style="--reveal-delay: 420ms">
      El diagnóstico convierte estas señales en prioridades concretas.
    </p>
  </Container>
</section>

<style>
  .problem {
    padding-block: var(--section-space);
    position: relative;
  }

  .problem__intro {
    align-items: end;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.7fr);
  }

  .section-eyebrow {
    color: var(--color-accent-light);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 3.8vw, 3.5rem);
    letter-spacing: -0.048em;
    line-height: 1.08;
    max-width: 15ch;
    text-wrap: balance;
  }

  .problem__lead,
  .problem__area > p:last-child {
    color: var(--color-text-muted);
  }

  .problem__lead {
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.125rem);
    max-width: 33rem;
    text-wrap: pretty;
  }

  .problem__areas {
    border-bottom: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .problem__area {
    min-width: 0;
    min-height: 16.5rem;
    padding: var(--space-4) clamp(1.25rem, 2.6vw, 2.5rem) var(--space-3);
    position: relative;
  }

  .problem__area + .problem__area {
    border-left: 1px solid var(--color-border);
  }

  .problem__number {
    color: var(--color-accent-light);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  h3 {
    font-size: clamp(1.3rem, 1.15rem + 0.55vw, 1.625rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-top: var(--space-6);
  }

  .problem__area > p:last-child {
    font-size: 0.9375rem;
    margin-top: var(--space-2);
    max-width: 25rem;
  }

  .problem__bridge {
    color: var(--color-text);
    font-size: clamp(1.125rem, 1.03rem + 0.35vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 28rem;
  }

  @media (max-width: 63.99rem) {
    .problem__intro {
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
    }

    h2 {
      max-width: 19ch;
    }
  }

  @media (max-width: 47.99rem) {
    .problem__areas {
      grid-template-columns: minmax(0, 1fr);
    }

    .problem__area {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-inline: clamp(.5rem, 3vw, 1.25rem);
      min-height: 0;
      padding-block: var(--space-4);
    }

    .problem__area + .problem__area {
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }

    .problem__number {
      grid-column: 1;
      grid-row: 1 / span 2;
      padding-top: 0.2rem;
    }

    h3,
    .problem__area > p:last-child {
      grid-column: 2;
    }

    h3 {
      margin-top: 0;
    }
  }
</style>
