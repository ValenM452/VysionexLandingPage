---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "compact";
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;
---

<a class:list={["action-link", `action-link--${variant}`, className]} href={href}>
  <slot />
</a>

<style>
  .action-link {
    align-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    display: inline-flex;
    font-size: 0.9375rem;
    font-weight: 700;
    justify-content: center;
    line-height: 1.2;
    min-height: 2.875rem;
    padding: 0.75rem 1.125rem;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .action-link:hover {
    transform: translateY(-2px);
  }

  .action-link:active {
    transform: translateY(0);
  }

  .action-link--primary,
  .action-link--compact {
    background: var(--color-accent);
    box-shadow: 0 10px 28px rgb(52 120 255 / 22%);
    color: var(--color-on-accent);
  }

  .action-link--primary:hover,
  .action-link--compact:hover {
    background: #4d89ff;
    box-shadow: 0 14px 32px rgb(52 120 255 / 30%);
  }

  .action-link--secondary {
    border-color: var(--color-border);
    background: rgb(10 20 48 / 48%);
    color: var(--color-text);
  }

  .action-link--secondary:hover {
    border-color: rgb(106 199 255 / 48%);
    background: rgb(16 29 59 / 88%);
  }

  .action-link--compact {
    min-height: 2.75rem;
    padding-inline: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .action-link:hover,
    .action-link:active {
      transform: none;
    }
  }
</style>
